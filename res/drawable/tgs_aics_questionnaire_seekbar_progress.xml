<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="20.0dip" />
            <solid android:color="#ffd3d3d3" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="7.5dip" />
                <gradient android:startColor="#ff0095ff" android:endColor="#ff0095ff" android:angle="0.0" android:type="linear" />
            </shape>
        </clip>
    </item>
</layer-list>