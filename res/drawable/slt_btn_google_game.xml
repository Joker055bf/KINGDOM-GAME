<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="@color/btn_google_game_pressed" android:endColor="@color/btn_google_game_pressed" android:angle="270.0" />
            <corners android:radius="@dimen/button_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/btn_google_game" android:endColor="@color/btn_google_game" android:angle="270.0" />
            <corners android:radius="@dimen/button_corner" />
        </shape>
    </item>
</selector>