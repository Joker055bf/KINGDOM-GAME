<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <padding android:left="@dimen/padding_small" android:top="@dimen/padding_normal" android:right="@dimen/padding_small" android:bottom="@dimen/padding_normal" />
            <stroke android:width="1.0px" android:color="@color/btn_login" />
            <corners android:radius="@dimen/padding_normal" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <padding android:left="@dimen/padding_small" android:top="@dimen/padding_normal" android:right="@dimen/padding_small" android:bottom="@dimen/padding_normal" />
            <stroke android:width="1.0px" android:color="@color/gray" />
            <corners android:radius="@dimen/padding_normal" />
        </shape>
    </item>
</selector>