<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="@color/bg_login_social" android:endColor="@color/bg_login_social" android:angle="270.0" />
            <corners android:radius="@dimen/button_corner" />
            <stroke android:width="1.0dip" android:color="@color/gray" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/white" android:endColor="@color/white" android:angle="270.0" />
            <corners android:radius="@dimen/button_corner" />
            <stroke android:width="1.0px" android:color="@color/gray" />
        </shape>
    </item>
</selector>