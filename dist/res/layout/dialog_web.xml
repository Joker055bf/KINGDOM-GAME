<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout android:layout_gravity="center_horizontal" android:background="@color/white" android:fitsSystemWindows="false" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_weight="1.0" android:keepScreenOn="true">
        <RelativeLayout android:layout_width="fill_parent" android:layout_height="@dimen/btn_height">
            <TextView android:textSize="@dimen/button_text_size" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@id/btnBack" android:paddingLeft="@dimen/padding_normal" android:paddingRight="@dimen/padding_normal" android:visibility="gone" android:clickable="true" android:layout_width="wrap_content" android:layout_height="fill_parent" android:layout_marginRight="@dimen/padding_xnormal" android:text="@string/lbl_back" android:layout_alignParentLeft="true" android:layout_centerVertical="true" />
            <TextView android:textSize="@dimen/button_text_size" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@id/btnClose" android:paddingLeft="@dimen/padding_normal" android:paddingRight="@dimen/padding_normal" android:clickable="true" android:layout_width="wrap_content" android:layout_height="fill_parent" android:layout_marginRight="@dimen/padding_xnormal" android:text="@string/close" android:layout_alignParentRight="true" android:layout_centerVertical="true" />
        </RelativeLayout>
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@id/swRegister" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/btn_height">
            <com.mobgame.gui.MobGameWebView2 android:id="@id/webview" android:scrollbars="none" android:layout_width="fill_parent" android:layout_height="fill_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <View android:background="@drawable/down_shadows" android:layout_width="fill_parent" android:layout_height="@dimen/padding_small" android:layout_marginTop="@dimen/btn_height" />
    </RelativeLayout>
    <LinearLayout android:orientation="vertical" android:id="@id/layout_keyboard_space" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_weight="1.0" />
</LinearLayout>